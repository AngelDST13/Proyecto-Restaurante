# URL donde n8n persistirá los eventos del proyecto.
# Con Docker, host.docker.internal permite llegar al json-server del host.
GOURMETSYNC_EVENT_API_URL=http://host.docker.internal:3001/eventos

# Resend para EMAIL_ENVIO.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
GOURMETSYNC_FROM_EMAIL=admin@elcacique.com
GOURMETSYNC_DEFAULT_EMAIL=admin@elcacique.com

# Endpoint de WhatsApp/SMS o middleware que notificará al mesero.
GOURMETSYNC_WA_NOTIFY_URL=https://example.invalid/webhooks/mesero-pedido-listo
