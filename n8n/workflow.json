{
  "name": "GourmetSync - Automatizaciones El Cacique",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cacique-master-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-cacique-master",
      "name": "Webhook GourmetSync",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst modulo = String(body.modulo || '').trim().toUpperCase();\nreturn [{\n  json: {\n    ...body,\n    modulo,\n    fechaProcesamiento: new Date().toISOString(),\n    valido: Boolean(modulo)\n  }\n}];"
      },
      "id": "normalize-gourmetsync-payload",
      "name": "Normalizar Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.modulo }}",
        "rules": {
          "rules": [
            { "value2": "RESERVA" },
            { "value2": "PEDIDO_MENU" },
            { "value2": "ALERTA_STOCK" },
            { "value2": "REGISTRO_CLIENTE" },
            { "value2": "EMAIL_ENVIO" },
            { "value2": "PROMOCION_CACIQUE" },
            { "value2": "LOGIN_SUCCESS" }
          ]
        },
        "fallbackOutput": 7
      },
      "id": "route-by-module",
      "name": "Enrutar por Módulo",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": { "jsCode": "return [{ json: { ok: true, modulo: 'RESERVA', accion: 'RESERVA_RECIBIDA', sede: $json.sede || 'escazu', referencia: $json.reservaId || $json.id || 'RES-101', recibidoEn: $json.fechaProcesamiento } }];" },
      "id": "handle-reserva",
      "name": "Procesar Reserva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, -180]
    },
    {
      "parameters": { "jsCode": "return [{ json: { ok: true, modulo: 'PEDIDO_MENU', accion: $json.accion || 'PEDIDO_RECIBIDO', orderId: $json.orderId || null, mesa: $json.mesa || null, sede: $json.sede || 'escazu', estado: $json.estadoNuevo || 'En Paila', notificarMesero: $json.accion === 'NOTIFICAR_MESERO_LISTO', recibidoEn: $json.fechaProcesamiento } }];" },
      "id": "handle-pedido",
      "name": "Procesar Pedido de Menú",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, -60]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.notificarMesero }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-order-ready",
      "name": "¿Pedido Listo para Mesero?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1140, -60]
    },
    {
      "parameters": { "jsCode": "return [{ json: { ok: true, modulo: 'ALERTA_STOCK', accion: 'ALERTA_STOCK_RECIBIDA', insumo: $json.insumo || 'Desconocido', stockActual: $json.stockActual || 0, limiteMinimo: $json.limiteMinimo || 10, sede: $json.sede || 'escazu', recibidoEn: $json.fechaProcesamiento } }];" },
      "id": "handle-stock",
      "name": "Procesar Alerta de Stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 60]
    },
    {
      "parameters": { "jsCode": "return [{ json: { ok: true, modulo: 'REGISTRO_CLIENTE', accion: 'CLIENTE_REGISTRADO', email: $json.email || null, nombre: $json.nombre || null, recibidoEn: $json.fechaProcesamiento } }];" },
      "id": "handle-cliente",
      "name": "Procesar Registro de Cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 180]
    },
    {
      "parameters": { "jsCode": "return [{ json: { ok: true, modulo: 'EMAIL_ENVIO', accion: 'COMUNICADO_RECIBIDO', destinatarioTipo: $json.destinatarioTipo || 'todos_clientes', especifico: $json.especifico || null, asunto: $json.asunto || 'Comunicado El Cacique', mensaje: $json.mensaje || '', sede: $json.sede || 'escazu', recibidoEn: $json.fechaProcesamiento } }];" },
      "id": "handle-email",
      "name": "Preparar Correo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": { "jsCode": "return [{ json: { ok: true, modulo: 'PROMOCION_CACIQUE', accion: $json.accion || 'PROMOCION_RECIBIDA', codigo: $json.codigo || 'CACIQUE2026', sede: $json.sede || 'escazu', recibidoEn: $json.fechaProcesamiento } }];" },
      "id": "handle-promotion",
      "name": "Procesar Promoción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 420]
    },
    {
      "parameters": { "jsCode": "return [{ json: { ok: true, modulo: 'LOGIN_SUCCESS', accion: 'LOGIN_REGISTRADO', usuario: $json.usuario || null, rol: $json.rol || null, recibidoEn: $json.fechaProcesamiento } }];" },
      "id": "handle-login",
      "name": "Procesar Login",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 540]
    },
    {
      "parameters": { "jsCode": "return [{ json: { ok: false, modulo: $json.modulo || 'DESCONOCIDO', error: 'Módulo no reconocido', recibidoEn: $json.fechaProcesamiento } }];" },
      "id": "handle-unknown",
      "name": "Módulo No Reconocido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 660]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://api.resend.com/emails",
        "options": {},
        "jsonParameters": true,
        "bodyParametersJson": "={{ JSON.stringify({ from: 'admin@elcacique.com', to: [$json.especifico || 'notificaciones@elcacique.com'], subject: $json.asunto, text: $json.mensaje }) }}"
      },
      "id": "send-gourmetsync-email",
      "name": "Enviar Correo con Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "http://localhost:3001/notificar-mesero",
        "options": {},
        "jsonParameters": true,
        "bodyParametersJson": "={{ JSON.stringify({ orderId: $json.orderId, mesa: $json.mesa, sede: $json.sede, mensaje: 'Pedido listo para entregar' }) }}"
      },
      "id": "notify-gourmetsync-waiter",
      "name": "Notificar Mesero Pedido Listo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1380, -120]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "http://localhost:3001/eventos",
        "options": {},
        "jsonParameters": true,
        "bodyParametersJson": "={{ JSON.stringify($json) }}"
      },
      "id": "persist-gourmetsync-event",
      "name": "Persistir Evento en GourmetSync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1620, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, procesado: true, evento: $json } }}",
        "options": {}
      },
      "id": "respond-gourmetsync-event",
      "name": "Responder Evento Procesado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1860, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-unknown",
      "name": "Responder Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1140, 660]
    }
  ],
